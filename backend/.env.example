APP_NAME=AI-Powered Document Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_document_assistant
DB_ECHO=false
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT_SECONDS=5
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_TYPES=["pdf","docx","txt"]
DEV_USER_EMAIL=dev@local.test
DEV_USER_NAME=Development User
PROCESS_UPLOADS_IN_BACKGROUND=true
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
EMBEDDING_PROVIDER=auto
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=60
ANSWER_CONTEXT_CHUNKS=6
ANSWER_MIN_SIMILARITY=0.0
ANSWER_MAX_CONTEXT_CHARS=8000
ANSWER_EXCERPT_CHARS=300
SUMMARY_MAX_CONTEXT_CHARS=12000
